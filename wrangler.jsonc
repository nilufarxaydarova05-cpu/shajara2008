{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shajara2008",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Baza birinchi deployda avtomatik yaratiladi (wrangler >= 4.45).
  "d1_databases": [{ "binding": "DB", "database_name": "shajara-db","database_id": "985dbc6a-8c59-44a6-ac36-08c50ac25629" }],
  "observability": { "enabled": true }
}
